{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  // 保存時の整形は codeActionsOnSave で行う。formatOnSave と併用すると整形が二重に走り、lint の修正との順番も決められない
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    // 整形してから lint の自動修正をかける
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  },
  // VS Code 組み込みの CSS 検査は Tailwind の @theme や @apply を Unknown at rule と警告する。Tailwind CSS IntelliSense の言語モードで開くと警告が出ない
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
