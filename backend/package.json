{
  "name": "@taleweaver/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/db/drizzle.config.ts",
    "db:check": "drizzle-kit check --config src/db/drizzle.config.ts",
    "sync:catalog": "tsx --env-file-if-exists=.env.development src/presentation/cli/sync-catalog.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
