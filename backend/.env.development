# devcontainer で動かすときの設定。ホスト名は .devcontainer/compose.yaml のサービス名。
# 秘密の値は書かない（このファイルはコミットする）。上書きしたい値は環境変数で渡す。ファイルの値より環境変数が優先される。
DATABASE_URL=postgres://postgres:postgres@db:5432/taleweaver
TEST_DATABASE_URL=postgres://postgres:postgres@test_db:5432/taleweaver_test

# 本番では S3_ENDPOINT・S3_ACCESS_KEY_ID・S3_SECRET_ACCESS_KEY を渡さず、AWS SDK の既定の認証情報（ECS のタスクロールなど）を使う。
# AWS_ACCESS_KEY_ID にしないのは、aws CLI を本物の AWS に向けたときに、この鍵が使われてしまうため。
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
# SeaweedFS はバケット名をホスト名に入れる指定（virtual-hosted style）を解決できない。
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=taleweaver
S3_SECRET_ACCESS_KEY=taleweaver-secret
IMAGES_BUCKET=taleweaver-images
