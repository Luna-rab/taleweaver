// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "taleweaver",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db", "test_db"],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/git:1.3.8": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:2.1.2": {
      "version": "latest"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  "postCreateCommand": "bash .devcontainer/post_create.sh",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker", //Docker
        //Typescript
        "oxc.oxc-vscode", //oxlint + oxfmt
        //Frontend
        "bradlc.vscode-tailwindcss", //Tailwind CSS IntelliSense
        "vitest.explorer", //Vitest
        //Git
        "github.vscode-pull-request-github", //GitHub Pull Requests
        "donjayamanne.githistory", //Git History
        "mhutchie.git-graph", //Git Graph
        //Tools
        "mechatroner.rainbow-csv", //Rainbow CSV
        "streetsidesoftware.code-spell-checker", //Code Spell Checker
        "anthropic.claude-code"
      ]
    }
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // gh auth login のトークン (hosts.yml) をリビルド後も残す
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
